    "d = df.dropna(subset=[\"Genres\", \"Price\"]).copy()\n",
    "d[\"Genre\"] = d[\"Genres\"].str.split(\",\")\n",
    "d = d.explode(\"Genre\")                     # 1 game nhiều thể loại -> mỗi thể loại 1 dòng\n",
    "d[\"Genre\"] = d[\"Genre\"].str.strip()\n",
    "\n",
    "# bỏ 2 nhãn không phải thể loại nội dung: Free To Play (trùng với giá) và Early Access (trạng thái phát hành)\n",
    "d = d[~d[\"Genre\"].isin([\"Free To Play\", \"Early Access\"])]\n",
    "\n",
    "top = d[\"Genre\"].value_counts().head(12).index\n",
    "d = d[d[\"Genre\"].isin(top)]\n",
    "\n",
    "tong_hop = d.groupby(\"Genre\").agg(\n",
    "    so_game=(\"Price\", \"size\"),\n",
    "    pct_free=(\"Price\", lambda s: (s == 0).mean() * 100),\n",
    "    gia_tv=(\"Price\", lambda s: s[s > 0].median()),\n",
    ").sort_values(\"gia_tv\")\n",
    "print(tong_hop.round(2))\n",
    "\n",
    "labels = [f\"{g} ({n:,})\" for g, n in zip(tong_hop.index, tong_hop[\"so_game\"])]\n",

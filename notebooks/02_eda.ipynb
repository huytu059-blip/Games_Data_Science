    "ket_qua = []\n",
    "\n",
    "# Achievements: game có ít nhất 1 thành tựu hay không\n",
    "co = rq_review[\"Achievements\"] > 0\n",
    "ket_qua.append([\"Có Achievements\", co.sum(),\n",
    "                rq_review.loc[co, \"Positive ratio\"].median(),\n",
    "                rq_review.loc[~co, \"Positive ratio\"].median()])\n",
    "\n",
    "# Một số tính năng trong cột Categories\n",
    "danh_sach = rq_review[\"Categories\"].fillna(\"\").str.split(\",\")\n",
    "danh_sach = danh_sach.apply(lambda ds: [x.strip() for x in ds])\n",
    "\n",
    "tinh_nang = [\"Single-player\", \"Multi-player\", \"Online PvP\", \"Co-op\", \"Steam Cloud\", \"Full controller support\"]\n",
    "for tn in tinh_nang:\n",
    "    co = danh_sach.apply(lambda ds: tn in ds)\n",
    "    ket_qua.append([tn, co.sum(),\n",
    "                    rq_review.loc[co, \"Positive ratio\"].median(),\n",
    "                    rq_review.loc[~co, \"Positive ratio\"].median()])\n",
    "\n",
    "bang_tn = pd.DataFrame(ket_qua, columns=[\"Tính năng\", \"Số game có\", \"Trung vị khi có (%)\", \"Trung vị khi không có (%)\"])\n",
    "bang_tn[\"Chênh lệch\"] = bang_tn[\"Trung vị khi có (%)\"] - bang_tn[\"Trung vị khi không có (%)\"]\n",
    "bang_tn = bang_tn.sort_values(\"Chênh lệch\")\n",
    "display(bang_tn.round(1))\n",
    "\n",
    "print(\"Tương quan Spearman giữa số Achievements và tỷ lệ tích cực:\",\n",
    "      round(rq_review[\"Achievements\"].corr(rq_review[\"Positive ratio\"], method=\"spearman\"), 2))\n",
    "\n",
    "mau = [\"tab:red\" if x < 0 else \"tab:green\" for x in bang_tn[\"Chênh lệch\"]]\n",
    "plt.figure(figsize=(10, 5))\n",
    "ax = plt.gca()\n",
    "ax.barh(bang_tn[\"Tính năng\"], bang_tn[\"Chênh lệch\"], color=mau)\n",

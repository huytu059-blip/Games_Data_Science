    "prices = df[\"Price\"].dropna()\n",
    "free = prices[prices == 0]\n",
    "paid = prices[prices > 0]\n",
    "\n",
    "edges = list(range(0, 31)) + [np.inf]\n",
    "paid_labels = [\"0,01-0,99\"] + [f\"{i}-{i+1}\" for i in range(1, 30)] + [\"≥30\"]\n",
    "paid_counts = (pd.cut(paid, bins=edges, labels=paid_labels, right=False)\n",
    "                 .value_counts().reindex(paid_labels))\n",
    "\n",
    "counts = pd.concat([pd.Series({\"Miễn phí\": len(free)}), paid_counts])\n",
    "colors = [sns.color_palette()[1]] + [sns.color_palette()[0]] * len(paid_counts)\n",
    "\n",
    "print(\"Tổng số game có giá hợp lệ:\", len(prices))\n",
    "print(\"Tổng các cột trong biểu đồ:\", counts.sum())\n",
    "print(\"Game miễn phí:\", len(free), f\"({len(free)/len(prices):.1%})\")\n",
    "print(\"Game trả phí dưới 1 USD:\", paid_counts[\"0,01-0,99\"])\n",
    "print(\"Game từ 30 USD trở lên:\", paid_counts[\"≥30\"])\n",
    "\n",
    "plt.figure()\n",
    "ax = plt.gca()\n",
    "ax.bar(range(len(counts)), counts.values, color=colors, edgecolor=\"white\")\n",
    "ax.bar_label(ax.containers[0], fmt=\"%d\", rotation=90, fontsize=8, padding=3)\n",
    "ax.set_ylim(0, counts.max() * 1.15)\n",
    "ax.set_xticks(range(len(counts)))\n",
    "ax.set_xticklabels(counts.index, rotation=60, ha=\"right\")\n",
    "ax.grid(axis=\"x\", visible=False)\n",
    "ax.set(title=\"Phân phối giá bán của trò chơi trên Steam\",\n",
    "       xlabel=\"Khoảng giá game (USD)\", ylabel=\"Số lượng bản ghi game\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },

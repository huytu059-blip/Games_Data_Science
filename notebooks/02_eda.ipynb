    "# chỉ xét game có lượt đề xuất, bỏ nhóm thiếu dữ liệu owners\n",
    "d = df[(df[\"Recommendations\"] > 0) & (df[\"Estimated owners\"] != \"0 - 0\")].copy()\n",
    "\n",
    "edges  = [0, 200, 500, 1000, 5000, 10000, 50000, 100000, np.inf]\n",
    "labels = [\"101-200\", \"201-500\", \"501-1.000\", \"1.001-5.000\",\n",
    "          \"5.001-10.000\", \"10.001-50.000\", \"50.001-100.000\", \">100.000\"]\n",
    "d[\"nhom\"] = pd.cut(d[\"Recommendations\"], bins=edges, labels=labels, right=True)\n",
    "\n",
    "tong_hop = d.groupby(\"nhom\", observed=True).agg(\n",
    "    so_game=(\"Peak CCU\", \"size\"),\n",
    "    ccu_trung_vi=(\"Peak CCU\", \"median\"),\n",
    ")\n",
    "print(tong_hop)\n",
    "\n",
    "plt.figure(figsize=(13, 6))\n",
    "ax = plt.gca()\n",
    "ax.bar(range(len(tong_hop)), tong_hop[\"ccu_trung_vi\"], edgecolor=\"white\")\n",
    "ax.bar_label(ax.containers[0], fmt=\"%.0f\", padding=3)\n",
    "ax.set_xticks(range(len(tong_hop)))\n",
    "ax.set_xticklabels([f\"{l}\\n({n:,} game)\" for l, n in zip(tong_hop.index, tong_hop[\"so_game\"])])\n",
    "ax.grid(axis=\"x\", visible=False)\n",
    "ax.set_ylim(0, tong_hop[\"ccu_trung_vi\"].max() * 1.12)\n",
